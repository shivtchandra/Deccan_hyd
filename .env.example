# --- No Google Maps API key anywhere in this project. ---
# Basemap = keyless OSM raster tiles. Coords/photos/routing come from
# OpenStreetMap / Wikidata / Wikimedia Commons / OSRM, all keyless.

# Firebase client (safe to expose — prefixed NEXT_PUBLIC_).
# Optional: without these the app runs local-only (passport works via
# localStorage; check-ins and submissions are inert).
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Firebase Admin (server-only — paste stringified service-account JSON).
FIREBASE_SERVICE_ACCOUNT=

# Editorial desk (/admin) and field desk (/admin/field) access keys.
# Server-only and fail-closed: with none set, nobody can sign in. Use long random values.
#   ADMIN_SECRET   owner key — full editorial rights
#   EDITOR_SECRET  a colleague's key — same rights as admin; rotate it on its own when they leave
#   FIELD_EDITORS  comma-separated "Name:key" pairs (e.g. Priya:key1,Rohan:key2) — can add sites
#                  and edit / hide only the ones they added; no access to visitor submissions
# Desk changes go live without a rebuild. In production they are stored in Firestore,
# so FIREBASE_SERVICE_ACCOUNT must be set (locally they fall back to files in data/).
ADMIN_SECRET=
EDITOR_SECRET=
FIELD_EDITORS=

# Optional: defaults to NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET.
FIREBASE_STORAGE_BUCKET=

# Cron auth — set the same value in Vercel env (fail-open when unset).
CRON_SECRET=

# Optional: overrides the public OSRM foot router used by the route builder.
# Default: https://router.project-osrm.org
OSRM_FOOT_URL=
